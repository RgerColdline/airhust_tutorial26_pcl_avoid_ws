<?xml version="1.0"?>
<launch>
    <!-- 仿真入口可替换；仅向它传递 world。 -->
    <arg name="sim_launch" default=""/>
    <arg name="world" default="$(find tutorial_pcl_avoid)/worlds/avoid_task.world"/>
    <arg name="seed" default="0"/>
    <arg name="cloud_topic" default="/cloud_registered"/>
    <arg name="msg_type" default="pointcloud2"/>
    <arg name="cloud_frame" default="world"/>
    <arg name="start_mission" default="true"/>

    <include file="$(eval arg('sim_launch') or find('simulation') + '/launch/sim.launch')">
        <arg name="world" value="$(arg world)"/>
    </include>

    <node pkg="tutorial_pcl_avoid" type="spawn_pillars.py" name="spawn_pillars" output="screen">
        <param name="seed" value="$(arg seed)"/>
    </node>

    <group if="$(arg start_mission)">
        <include file="$(find tutorial_pcl_avoid)/launch/mission.launch">
            <arg name="cloud_topic" value="$(arg cloud_topic)"/>
            <arg name="msg_type" value="$(arg msg_type)"/>
            <arg name="cloud_frame" value="$(arg cloud_frame)"/>
        </include>
    </group>
</launch>
